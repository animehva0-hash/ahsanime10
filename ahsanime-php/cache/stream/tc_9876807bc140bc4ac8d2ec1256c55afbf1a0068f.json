{"cues":[{"id":1,"start":2.63,"end":4.67,"text":"Daulat, shohrat, taakat...","translated":true},{"id":2,"start":4.67,"end":6.57,"text":"Gold Roger,\nPirates ka King,","translated":true},{"id":3,"start":6.57,"end":8.87,"text":"Iss duniya ki har cheez\nhasil kar chuka tha.","translated":true},{"id":4,"start":8.87,"end":12.74,"text":"Maut se pehle uske bol\nlogon ko samandar le aaye.","translated":true},{"id":5,"start":12.74,"end":16.58,"text":"Mera khazana? Agar chahiye,\ntoh le lo tum sab!","translated":true},{"id":6,"start":16.58,"end":20.14,"text":"Dhundh lo! Sab wahi\nchhod kar aaya Hu Mai!","translated":true},{"id":7,"start":22.75,"end":27.49,"text":"Aur sab nikal pade Grand Line\napne sapne Puche karne!","translated":true},{"id":8,"start":27.49,"end":31.39,"text":"Duniya mein shuru ho chuka hai\nMahan Pirate Yug!","translated":true},{"id":9,"start":31.39,"end":36.76,"text":"Hum apne saare sapne\nekathaa karne chale Hai","translated":true},{"id":10,"start":36.76,"end":42.67,"text":"aur kuch Dhundhne ke liye\nab nikal pade Hai","translated":true},{"id":11,"start":42.67,"end":44,"text":"ONE PIECE!","translated":true},{"id":12,"start":48.94,"end":54.52,"text":"Compass se bas der hoti hai","translated":true},{"id":13,"start":54.52,"end":60.25,"text":"Bukhar mein pagal ho kar,\nMai thaamta Hu helm","translated":true}],"full":false,"lang":"hinglish","url":"https:\/\/shonen.to\/api\/v1\/zoko-media?u=aHR0cHM6Ly9obHMuZHJhbWFob3QudG9wL3Yvc2N4cWljeS90YTl0NG0xYmh3L2NtNzJma3ZicHgvMDlxbXc3azZtaTVuemQvc3Vicy82ZTRhMHAzazhlaGU5ZWVlLnZ0dA&e=1795414584&k=vtt&s=7857018c458845c52107a060f856a3c8aedbe37877898e3fb66d822f58ee8ce2","updatedAt":1795401624}