{"cues":[{"id":1,"start":4.81,"end":10.59,"text":"Insaan Humesha se behtar ban'ne ki koshish\nkarta hai.","translated":true},{"id":2,"start":13.22,"end":19.79,"text":"Aur agar kabhi koi aisi taakat aaye jo\nHume khatra de,","translated":true},{"id":3,"start":24.18,"end":27.9,"text":"Toh Woh bina kisi shak ke ek insaan hi\nhoga.","translated":true},{"id":4,"start":54.3,"end":56.05,"text":"Guard Shield!","translated":true},{"id":5,"start":58.39,"end":60.14,"text":"Dekha tune? Current lag gaya!","translated":true},{"id":6,"start":63.02,"end":66.9,"text":"Shayad mere chehre se na lage, par Mai\nlevel 73 par Hu... Kam mat samajh mujhe!","translated":true},{"id":7,"start":78.69,"end":79.53,"text":"Satte pe satta!","translated":true},{"id":8,"start":79.53,"end":82.12,"text":"Kya Mai Sachme yeh quest khatam kar\npaunga?","translated":true},{"id":9,"start":80.47,"end":84.97,"text":"Secret Quest: Earl Ashur's Request (S)\nPatrian ke shasak ka aadesh hai ki tum\nBaghma ke lohar ki Techniques Waala secret\nregister Dhundo! Inaam: Suraj ki Talwar\nSaza: Patrian ke ilaqe mein entry ban, aur\ndo level ki haar.","translated":true},{"id":10,"start":80.47,"end":84.97,"text":"m 0 0 l 200 0 200 55 0 55","translated":true},{"id":11,"start":81.15,"end":82.5,"text":"System ki hidayat.","translated":true},{"id":12,"start":82.5,"end":85.68,"text":"Tera abhi ka quest hai: Ek secret request.","translated":true},{"id":13,"start":84.97,"end":86.84,"text":"Iss quest ko chhoda nahi ja sakta.","translated":true},{"id":14,"start":85.68,"end":87.81,"text":"Iss quest ko chhoda nahi ja sakta.","translated":true},{"id":15,"start":87.45,"end":88.8,"text":"Ashur!","translated":true},{"id":16,"start":89.02,"end":92.50999999999999,"text":"Tu sirf ek NPC hai, kiye kaise tune mujhe\nek namumkin quest de diya?","translated":true},{"id":17,"start":102.53,"end":105.44,"text":"Grid","translated":true},{"id":18,"start":102.53,"end":105.44,"text":"m 0 0 l 55 0 55 8 0 8","translated":true},{"id":19,"start":102.53,"end":105.44,"text":"Swordsman","translated":true},{"id":20,"start":102.53,"end":105.44,"text":"m 0 0 l 50 0 50 8 0 8","translated":true},{"id":21,"start":102.53,"end":105.44,"text":"Category","translated":true},{"id":22,"start":102.53,"end":105.44,"text":"m 0 0 l 55 0 55 8 0 8","translated":true},{"id":23,"start":102.53,"end":105.44,"text":"Normal","translated":true},{"id":24,"start":102.53,"end":105.44,"text":"m 0 0 l 50 0 50 8 0 8","translated":true},{"id":25,"start":102.53,"end":105.44,"text":"Rank","translated":true},{"id":26,"start":102.53,"end":105.44,"text":"m 0 0 l 57 0 57 8 0 8","translated":true},{"id":27,"start":105.44,"end":111.12,"text":"Iss bakwaas game ki ma ki!","translated":true},{"id":28,"start":115.22999999999999,"end":119.2,"text":"Khush, duniya ka sabse behtareen VR\ngame.","translated":true},{"id":29,"start":125.26,"end":129.52,"text":"Jise duniya bhar mein do arab Player\nkhelte Hai.","translated":true},{"id":30,"start":130.27,"end":135.28,"text":"Aur iski fantasy duniya itni badi hai ki\nIsey aksar 'Doosri Prithvi' kaha jata hai.","translated":true},{"id":31,"start":139.71,"end":142.84,"text":"Aur game ke andar jo paisa aur izzat milti\nhai,","translated":true},{"id":32,"start":142.84,"end":147.15,"text":"Woh asli duniya mein aapke bank account aur\nUspar","translated":true},{"id":33,"start":145.44,"end":150.32999999999998,"text":"Duniya ke sabse top rank wale Player\nabhi!","translated":true},{"id":34,"start":147.15,"end":150.41,"text":"Toh iska asar bahut bada hai.","translated":true},{"id":35,"start":150.46,"end":151.15,"text":"Akhirkar, pehla rank Waala Player purvi\nmaha-dwip pahunch gaya!","translated":true},{"id":36,"start":151.15,"end":151.19,"text":"Akhirkar, pehla rank Waala Player purvi\nmaha-dwip pahunch gaya!","translated":true},{"id":37,"start":151.19,"end":151.23,"text":"Akhirkar, pehla rank Waala Player purvi\nmaha-dwip pahunch gaya!","translated":true},{"id":38,"start":151.23,"end":151.27,"text":"Akhirkar, pehla rank Waala Player purvi\nmaha-dwip pahunch gaya!","translated":true},{"id":39,"start":151.27,"end":151.31,"text":"Akhirkar, pehla rank Waala Player purvi\nmaha-dwip pahunch gaya!","translated":true},{"id":40,"start":151.31,"end":151.35,"text":"Akhirkar, pehla rank Waala Player purvi\nmaha-dwip pahunch gaya!","translated":true},{"id":41,"start":151.35,"end":151.4,"text":"Akhirkar, pehla rank Waala Player purvi\nmaha-dwip pahunch gaya!","translated":true},{"id":42,"start":151.4,"end":151.44,"text":"Akhirkar, pehla rank Waala Player purvi\nmaha-dwip pahunch gaya!","translated":true},{"id":43,"start":151.44,"end":151.48,"text":"Akhirkar, pehla rank Waala Player purvi\nmaha-dwip pahunch gaya!","translated":true},{"id":44,"start":151.48,"end":151.52,"text":"Akhirkar, pehla rank Waala Player purvi\nmaha-dwip pahunch gaya!","translated":true},{"id":45,"start":151.52,"end":151.79,"text":"Akhirkar, pehla rank Waala Player purvi\nmaha-dwip pahunch gaya!","translated":true},{"id":46,"start":155.28,"end":157.36,"text":"Satte pe satta!","translated":true},{"id":47,"start":157.68,"end":161.2,"text":"Yeh sab Earl Ashur ki wajah se hai.","translated":true},{"id":48,"start":162.88,"end":167.32999999999998,"text":"Aur meri wajah se bhi, kyunki maine level\n73 par hone ke bawajood S rank ka secret\nquest liya.","translated":true},{"id":49,"start":169.11,"end":172.92000000000002,"text":"Mujhe lagta hai yeh quests unke liye Hai\njo kareeb level 300 ke Hai.","translated":true},{"id":50,"start":173.72,"end":176.63,"text":"Par agar Mai Iss game mein mehnat karu,","translated":true},{"id":51,"start":177.82,"end":178.93,"text":"Toh Mai bhi...","translated":true},{"id":52,"start":180.51,"end":182.66,"text":"Amir ban sakta Hu Mai bhi!","translated":true},{"id":53,"start":184.98,"end":187.73,"text":"Aur... mil gaya mujhe.","translated":true},{"id":54,"start":187.73,"end":190.14,"text":"Woh bahut mushkil tha.","translated":true},{"id":55,"start":190.14,"end":193.26,"text":"Yeh kameeni quest mujhe Isey chhodne nahi\nde rahi thi.","translated":true},{"id":56,"start":193.26,"end":195.82,"text":"Mai itna gusse mein tha ki account delete\nkarne Waala tha.","translated":true},{"id":57,"start":196.9,"end":201.09,"text":"Legendary Craftsman ka Register","translated":true},{"id":58,"start":196.9,"end":201.09,"text":"Rank","translated":true},{"id":59,"start":196.9,"end":201.09,"text":"Iss kitab ko parakhne ke liye (Fralian ki\naankh) chahiye.","translated":true},{"id":60,"start":197.31,"end":198.88,"text":"Pehchaan anjaan hai...","translated":true},{"id":61,"start":198.88,"end":201.32999999999998,"text":"Kya Fralian ki aankh...","translated":true},{"id":121,"start":327.66,"end":332.21,"text":"Shart: Earl Ashur aur uske guard ko maaro.","translated":true},{"id":122,"start":329.06,"end":332.21,"text":"Earl Ashur?! Mazak kar rahe ho kya!","translated":true},{"id":123,"start":329.8,"end":332.62,"text":"Humara Bharoosa tod kar yeh harkat ki\nhai...","translated":true},{"id":124,"start":332.62,"end":334.64,"text":"Mai tumhe wahi dunga jiske tum kabil ho.","translated":true},{"id":125,"start":334.64,"end":337.25,"text":"Bakwaas mat karo! Itni mehnat ki hai\nmaine...","translated":true},{"id":126,"start":335.43,"end":338.21,"text":"Fail hone ka matlab player ki maut hai.","translated":true},{"id":127,"start":337.25,"end":338.21,"text":"Maut.","translated":true},{"id":128,"start":338.21,"end":340.89,"text":"Aur tumhari reputation bhi kharab hogi,","translated":true},{"id":129,"start":339.71,"end":340.89,"text":"Pakdo isko!","translated":true},{"id":130,"start":340.89,"end":343.35,"text":"Jisse Patrian ke ilaqe mein entry nahi\nmilegi.","translated":true},{"id":131,"start":343.35,"end":347.55,"text":"Aur S-rank ya usse upar ka mission fail\nhone par,","translated":true},{"id":132,"start":345.78,"end":346.68,"text":"Dhatt!","translated":true},{"id":133,"start":346.68,"end":350.08,"text":"Itni mehnat ka natija sirf yeh mila?!","translated":true},{"id":134,"start":347.55,"end":350.08,"text":"Tumhara level do level niche gir jayega.","translated":true},{"id":135,"start":350.08,"end":352.02,"text":"Mujhe yeh bilkul manzur nahi hai!","translated":true},{"id":136,"start":354.1,"end":355.6,"text":"Kitab jaldi wapas lo!","translated":true},{"id":137,"start":360.5,"end":362.11,"text":"Kitna afsos ki baat hai.","translated":true},{"id":138,"start":362.11,"end":364.15,"text":"Bohot der ho chuki hai dhokebaaz!","translated":true},{"id":139,"start":365.61,"end":367.18,"text":"System instructions.","translated":true},{"id":140,"start":365.75,"end":370.58,"text":"Class change shuru ho rahi hai.","translated":true},{"id":141,"start":367.18,"end":371.5,"text":"Tumhari current class ki skills aur stats\nzero ho jayengi.","translated":true},{"id":142,"start":371.5,"end":375.37,"text":"Class change ho kar Legendary Blacksmith,\nPagma's Successor ban jayegi.","translated":true},{"id":143,"start":382.26,"end":385.38,"text":"Tumhe Master Blacksmith ki skills mil gayi\nHai.","translated":true},{"id":144,"start":382.94,"end":387.76,"text":"Master Blacksmith's Appraisal,\nSe ek","translated":true},{"id":145,"start":382.94,"end":387.76,"text":"m 0 0 l 200 0 200 42 0 42","translated":true},{"id":146,"start":385.84,"end":389.91,"text":"Se ek\npar, khul gaya hai","translated":true},{"id":147,"start":387.76,"end":392.22,"text":"Legendary Blacksmith ki skills aur\nAppraisal mil gaya hai.","translated":true},{"id":148,"start":387.76,"end":394.18,"text":"m 0 0 l 250 0 250 20 0 20","translated":true},{"id":149,"start":389.91,"end":394.18,"text":"Techniques ka sabse High level, Legendary\nBlacksmith techniques.","translated":true},{"id":150,"start":392.22,"end":394.18,"text":"Legendary Blacksmith's Patience aur\nCraftsmanship mil gaya hai.","translated":true},{"id":151,"start":394.59000000000003,"end":397.1,"text":"Perseverance stat unlock ho gaya hai.","translated":true},{"id":152,"start":403.72,"end":405.57,"text":"Class change poori ho gayi.","translated":true},{"id":153,"start":405.57,"end":408.48,"text":"Mujhe andar tak taakat Mehsus ho rahi\nhai...","translated":true},{"id":154,"start":405.75,"end":408.67,"text":"Legendary","translated":true},{"id":155,"start":405.94,"end":408.67,"text":"Title","translated":true},{"id":156,"start":406.62,"end":408.87,"text":"Tumhe ek title mila hai.","translated":true},{"id":157,"start":409.12,"end":411.4,"text":"Ashur the coward darr gaya hai.","translated":true},{"id":158,"start":411.4,"end":412.45,"text":"Kya jabardast ehsaas hai!","translated":true},{"id":159,"start":415.76,"end":418.46,"text":"Sab Taiyar ho jao!","translated":true},{"id":160,"start":419.31,"end":421.34,"text":"Mai tum sabko hara dunga...","translated":true},{"id":161,"start":419.92,"end":421.34,"text":"Tum level 1 par ho.","translated":true},{"id":162,"start":424.05,"end":425.01,"text":"Grid","translated":true},{"id":163,"start":424.05,"end":425.01,"text":"m 0 0 l 72 0 72 13 0 13","translated":true},{"id":164,"start":424.05,"end":425.01,"text":"Pagma's Successor","translated":true},{"id":165,"start":424.05,"end":425.01,"text":"m 0 0 l 155 0 155 16 0 16","translated":true},{"id":166,"start":424.05,"end":425.01,"text":"Legendary","translated":true},{"id":167,"start":424.05,"end":425.01,"text":"m 0 0 l 155 0 155 16 0 16","translated":true},{"id":168,"start":424.05,"end":425.01,"text":"Legendary","translated":true},{"id":169,"start":424.05,"end":425.01,"text":"m 0 0 l 185 0 185 16 0 16","translated":true},{"id":170,"start":424.05,"end":425.01,"text":"Class","translated":true},{"id":171,"start":424.05,"end":425.01,"text":"m 0 0 l 68 0 64 13 0 13","translated":true},{"id":172,"start":424.05,"end":425.01,"text":"Rank","translated":true},{"id":173,"start":424.05,"end":425.01,"text":"m 0 0 l 68 0 64 13 0 13","translated":true},{"id":174,"start":424.05,"end":425.01,"text":"Title","translated":true},{"id":175,"start":424.05,"end":425.01,"text":"m 0 0 l 68 0 64 13 0 13","translated":true},{"id":176,"start":432.74,"end":436.16,"text":"Tum mar gaye ho.","translated":true},{"id":177,"start":433.38,"end":437.8,"text":"SS-rank mission fail hone se tumhara level\ndo level gir gaya hai.","translated":true},{"id":178,"start":439.68,"end":443.06,"text":"Tumhara current character level minus 1\nhai.","translated":true},{"id":179,"start":447.24,"end":450.74,"text":"Tokyo","translated":true},{"id":180,"start":450.84,"end":456.04,"text":"Khush development Aur operation company","translated":true},{"id":181,"start":450.84,"end":456.04,"text":"SA Group","translated":true},{"id":182,"start":451.84,"end":456.04,"text":"Mujhe yakeen nahi ho raha inhone subah\nsubah yahan bulaya.","translated":true},{"id":183,"start":456.04,"end":457.42,"text":"Kuch kiya nahi ja sakta.","translated":true},{"id":241,"start":608.28,"end":615.49,"text":"Toh uske stats baaki Dusre users se Jyada\nho jaayenge!","translated":true},{"id":242,"start":617.45,"end":622.18,"text":"Aur uske baad bhi, kya hum isko ittefaq\nkeh sakte Hai?","translated":true},{"id":243,"start":631.06,"end":634.84,"text":"Duniya ka sabse behtareen game? Kitni\nBehuda baat hai!","translated":true},{"id":244,"start":635.16,"end":638.04,"text":"Meri saari mehnat mujhe waapas do!","translated":true},{"id":245,"start":638.04,"end":642.1,"text":"Aur mujhe Iss capsule ka rent bhi dena hai\nabhi!","translated":true},{"id":246,"start":643.28,"end":645.6,"text":"Bhaiya, uth gaye kya aap?","translated":true},{"id":247,"start":647.56,"end":650.05,"text":"Phir se khel rahe ho kya?","translated":true},{"id":248,"start":652,"end":654.87,"text":"Aise darao mat mujhe, Sera!","translated":true},{"id":249,"start":654.87,"end":657.07,"text":"Kamre ko thoda saaf Kyu nahi rakhte?","translated":true},{"id":250,"start":658.88,"end":661.35,"text":"Aur aakhri baar nahaye kab the tum?","translated":true},{"id":251,"start":661.35,"end":664.12,"text":"Sera, bakwaas band karo apni.","translated":true},{"id":252,"start":666.59,"end":669.08,"text":"Mummy aur papa pareshan Hai tumhare liye.","translated":true},{"id":253,"start":669.9,"end":673.73,"text":"Takumi, yeh sab band karo ab!","translated":true},{"id":254,"start":673.73,"end":676.31,"text":"Agar itna waqt hai tumhare Pass, raat bhar\njaagte ho jo,","translated":true},{"id":255,"start":676.31,"end":677.5,"text":"Toh dukaan pe madad karwao Humari!","translated":true},{"id":256,"start":677.5,"end":680.64,"text":"S-Sabzi ki dukaan pe aisi koi bheed nahi\nhai jahan madad chahiye ho!","translated":true},{"id":257,"start":680.85,"end":681.93,"text":"Bahaane banana band karo apna!","translated":true},{"id":258,"start":681.93,"end":684.6,"text":"Khair, yeh Achhi baat hai ki woh kisi\ncheez mein toh mehnat karta hai.","translated":true},{"id":259,"start":684.6,"end":685.68,"text":"Sir par mat chadhao isko!","translated":true},{"id":260,"start":687.58,"end":690.27,"text":"M-Mujhe lagta hai yeh kaafi hai.","translated":true},{"id":261,"start":690.27,"end":692.14,"text":"Hey bhagwan!","translated":true},{"id":262,"start":692.84,"end":694.74,"text":"Khaana table par laga hai.","translated":true},{"id":263,"start":694.74,"end":696.78,"text":"Hum kaam par ja rahe Hai.","translated":true},{"id":264,"start":696.78,"end":700.17,"text":"Apne din ke kaam ke liye late mat hona!","translated":true},{"id":265,"start":701.76,"end":703.95,"text":"Aaj Khush Every mein...","translated":true},{"id":266,"start":703.95,"end":707.16,"text":"Good morning. Aaj ke Khush Times ka waqt\nho gaya hai.","translated":true},{"id":267,"start":704.99,"end":709.36,"text":"Kamaal hai. Yeh game Sachme bohot\nmashoor hai.","translated":true},{"id":268,"start":709.36,"end":711.67,"text":"Kitne saare channels Hai jo sirf iske\nliye Hai.","translated":true},{"id":269,"start":709.36,"end":714.24,"text":"Khush News! Aaj sab log isi user ki baat\nkar rahe Hai.","translated":true},{"id":270,"start":711.67,"end":714.53,"text":"Dekha? Isse bohot saare paiye kamaaye ja\nsakte Hai.","translated":true},{"id":271,"start":715.28,"end":718.34,"text":"Overall rankings mein paanchve number par\nhai...","translated":true},{"id":272,"start":716.38,"end":718.34,"text":"Kitni Khubsurat hai yaar...","translated":true},{"id":273,"start":718.34,"end":720.51,"text":"Aur dark mages mein pehle number par hai!","translated":true},{"id":274,"start":720.51,"end":722.17,"text":"Yeh Yura hai, khooni Mega!","translated":true},{"id":275,"start":722.17,"end":722.82,"text":"Yura!","translated":true},{"id":276,"start":722.82,"end":725.11,"text":"Yura? Wahi supermodel? Jo itni mashoor\nhai?","translated":true},{"id":277,"start":725.11,"end":727.99,"text":"Haan. Woh bohot hi famous Player hai.","translated":true},{"id":278,"start":725.72,"end":728.44,"text":"Aur uska husn sirf game tak hi mehdood\nnahi hai.","translated":true},{"id":279,"start":727.99,"end":732.65,"text":"Asli duniya mein bhi uska naam hai game ki\nwajah se.","translated":true},{"id":280,"start":728.44,"end":729.41,"text":"Asli duniya mein bhi,","translated":true},{"id":281,"start":729.41,"end":733.36,"text":"TV shows aur fashion ramps par woh Humesha\nchaayi rehti hai!","translated":true},{"id":282,"start":733.36,"end":736.35,"text":"Woh ek bilkul hi alag duniya mein rehti\nhai tumse.","translated":true},{"id":283,"start":736.35,"end":737.92,"text":"Aise mat bolo yaar!","translated":true},{"id":284,"start":739.7,"end":741.15,"text":"Nagamine-san!","translated":true},{"id":285,"start":740.32,"end":743.87,"text":"Suraksha ki poori guarantee.","translated":true},{"id":286,"start":740.32,"end":743.87,"text":"Human resources aur training.","translated":true},{"id":287,"start":740.32,"end":743.87,"text":"Matsuhira Temporary Employment Company.","translated":true},{"id":288,"start":741.94,"end":743.87,"text":"Nagamine Takumi-san!","translated":true},{"id":289,"start":743.87,"end":745.43,"text":"J-Ji?","translated":true},{"id":290,"start":745.43,"end":746.83,"text":"Jaldi se yahan aao zara.","translated":true},{"id":291,"start":747.09,"end":748.65,"text":"Aapki mehnat ke liye shukriya.","translated":true},{"id":292,"start":750.39,"end":754,"text":"Raat bhar game khelne ke baad mazdoori\nkarna Sachme thaka deta hai.","translated":true},{"id":293,"start":754,"end":757.46,"text":"Woh ladka Sachme game ka nasha karta\nhai.","translated":true},{"id":294,"start":757.46,"end":760.23,"text":"Kya? Phir toh kisi kaam ka nahi hai.","translated":true},{"id":295,"start":760.23,"end":763.48,"text":"Aise log koi bhi kaam kharab hi karte\nHai.","translated":true},{"id":296,"start":766.8,"end":771.66,"text":"Chalo, isse mera student loan aur Iss\nmahine ka game subscription nikal jaayega.","translated":true},{"id":297,"start":771.66,"end":774.61,"text":"Aur jo extra paisa maine kharch kiya\nhai...agle mahine chukaa dunga.","translated":true},{"id":298,"start":775.09,"end":778.76,"text":"Mai kar kya raha Hu?","translated":true},{"id":299,"start":780.88,"end":784.62,"text":"Kuch bhi kar lo, kabhi kuch theek nahi\nhota.","translated":true},{"id":300,"start":785.31,"end":787.21,"text":"Jab Mai student tha, mujhe tang kiya\njaata tha.","translated":true},{"id":301,"start":788.06,"end":790.04,"text":"Aur pehli ladki jisse maine pyaar kiya,\nusne bilkul parwaah nahi ki.","translated":true},{"id":302,"start":791.27,"end":795.47,"text":"Toh maine socha agar Mai game mein mehnat\nkarun aur ameer ban jaun,","translated":true},{"id":303,"start":795.47,"end":798.6,"text":"Toh Mai unhe sabit karunga, thoda hi\nsahi, ki woh galat the mujh par.","translated":true},{"id":304,"start":799.99,"end":800.99,"text":"...Lekin ab,","translated":true},{"id":305,"start":801.71,"end":804.01,"text":"Mai jo kuch bhi karta Hu, bas apne\nparivaar ko pareshan karta Hu.","translated":true},{"id":306,"start":805.74,"end":810.68,"text":"Shayad mujhe game chhod dena chahiye aur\nkuch aur karna chahiye.","translated":true},{"id":307,"start":815.71,"end":820.15,"text":"Lekin maine Sachme apni class ko\nlegendary class mein badal liya hai.","translated":true},{"id":308,"start":820.72,"end":824.42,"text":"!Shayad Mai thoda aur Theek sakta Hu!","translated":true},{"id":309,"start":829.78,"end":830.95,"text":"!Khush!","translated":true},{"id":310,"start":831.62,"end":832.52,"text":"Kya tu taiyar hai?","translated":true},{"id":311,"start":832.52,"end":833.53,"text":"Haan.","translated":true},{"id":312,"start":835.42,"end":836.86,"text":"Taiyar ho ja.","translated":true},{"id":313,"start":837.38,"end":840.42,"text":"...3, do, ek.","translated":true},{"id":314,"start":840.42,"end":841.29,"text":"!Taiyar!","translated":true},{"id":315,"start":841.29,"end":842.45,"text":"!Andar jao!","translated":true},{"id":316,"start":843.19,"end":845.33,"text":"Khush se connection jud raha hai.","translated":true},{"id":317,"start":852.87,"end":854.08,"text":"Mai kahan Hu?","translated":true},{"id":318,"start":854.08,"end":855.36,"text":"System ke nirdesh.","translated":true},{"id":319,"start":855.36,"end":857.02,"text":"Mission poura karne mein asafal hone ke\nkaaran,","translated":true},{"id":320,"start":857.02,"end":859.97,"text":"Ab tum Patrian ki zameen mein Entry nahi\nkar sakte.","translated":true},{"id":321,"start":862.53,"end":872,"text":"Grid","translated":true},{"id":322,"start":862.53,"end":872,"text":"m 0 0 l 40 0 40 8 0 8","translated":true},{"id":323,"start":862.53,"end":872,"text":"Class","translated":true},{"id":324,"start":862.53,"end":872,"text":"m 0 0 l 30 0 30 6 0 6","translated":true},{"id":325,"start":862.53,"end":872,"text":"Pagma ka\nउत्तराधिकारी","translated":true},{"id":326,"start":862.53,"end":872,"text":"m 0 0 l 75 0 75 6 0 6","translated":true},{"id":327,"start":862.53,"end":872,"text":"Rank","translated":true},{"id":328,"start":862.53,"end":872,"text":"m 0 0 l 30 0 30 6 0 6","translated":true},{"id":329,"start":862.53,"end":872,"text":"Legendary","translated":true},{"id":330,"start":862.53,"end":872,"text":"m 0 0 l 75 0 75 6 0 6","translated":true},{"id":331,"start":862.53,"end":872,"text":"Title","translated":true},{"id":332,"start":862.53,"end":872,"text":"m 0 0 l 